{
  "name": "arrow-escape",
  "version": "1.0.0",
  "description": "Arrow Escape \u2014 a neon arrow puzzle game. 520 procedural levels, power-ups, daily puzzles, offline play.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 4173",
    "serve": "npx --yes http-server -p 4173 -c-1 .",
    "build": "node tools/build.mjs",
    "test": "node tests/logic.test.mjs && node tests/dom.test.mjs",
    "test:logic": "node tests/logic.test.mjs",
    "test:dom": "node tests/dom.test.mjs"
  },
  "keywords": [
    "game",
    "puzzle",
    "arrows",
    "canvas",
    "pwa",
    "offline"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "puppeteer-core": "^25.16.0"
  }
}
